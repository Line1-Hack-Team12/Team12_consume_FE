{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://52.62.120.216:8080/api/:path*" },
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
